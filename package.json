{
  "name": "pump-it-up",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/server",
    "packages/web",
    "packages/intelligence"
  ],
  "scripts": {
    "dev": "yarn workspace @pump-it-up/server dev",
    "dev:server": "yarn workspace @pump-it-up/server dev",
    "dev:web": "yarn workspace @pump-it-up/web dev",
    "test": "yarn workspace @pump-it-up/server test",
    "build": "yarn workspaces run build",
    "typecheck": "yarn workspaces run typecheck",
    "lint": "eslint \"packages/**/*.ts\" \"packages/**/tests/**/*.ts\" \"packages/**/scripts/**/*.ts\" \"packages/**/vitest*.ts\"",
    "validate": "yarn lint && yarn typecheck && yarn test",
    "test:e2e": "yarn workspace @pump-it-up/server test:e2e",
    "test:e2e:base": "APP_NETWORK=base yarn test:e2e",
    "test:e2e:base-sepolia": "APP_NETWORK=base-sepolia yarn test:e2e",
    "test:e2e:doppler": "doppler run --project openclaw --config dev -- yarn test:e2e:base && doppler run --project openclaw --config dev -- yarn test:e2e:base-sepolia",
    "ci": "yarn lint && yarn workspace @pump-it-up/server typecheck && yarn test:e2e:base && yarn test:e2e:base-sepolia",
    "intel": "yarn workspace @fleet/intelligence cli",
    "intel:sync": "yarn workspace @fleet/intelligence cli sync",
    "intel:recent": "yarn workspace @fleet/intelligence cli recent",
    "intel:alerts": "yarn workspace @fleet/intelligence cli alerts",
    "intel:watchlist": "yarn workspace @fleet/intelligence cli watchlist:list"
  },
  "dependencies": {
    "@zoralabs/coins-sdk": "0.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.2.0",
    "typescript-eslint": "^8.58.0"
  }
}

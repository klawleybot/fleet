{
  "name": "@fleet/intelligence",
  "version": "1.0.0",
  "description": "Zora coin intelligence engine",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts",
    "./engine": "./src/engine.ts"
  },
  "scripts": {
    "cli": "bun x tsx src/cli.ts",
    "test": "bun x tsx --test src/**/*.test.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "sync": "bun x tsx src/cli.ts sync",
    "poll-once": "bun x tsx src/cli.ts poll-once",
    "daemon:start": "bun x tsx src/cli.ts daemon:start",
    "daemon:stop": "bun x tsx src/cli.ts daemon:stop",
    "daemon:status": "bun x tsx src/cli.ts daemon:status",
    "daemon:run": "bun x tsx src/cli.ts daemon:run",
    "recent": "bun x tsx src/cli.ts recent 20",
    "top-volume": "bun x tsx src/cli.ts top-volume 20",
    "analytics": "bun x tsx src/cli.ts analytics 20",
    "alerts": "bun x tsx src/cli.ts alerts 20",
    "first-coin": "bun x tsx src/cli.ts first-coin",
    "contracts": "bun x tsx src/cli.ts contracts",
    "start": "bun x tsx src/cli.ts help",
    "dispatch-alerts": "bun x tsx src/cli.ts dispatch-alerts 12",
    "dispatch-alerts-rich": "bun x tsx src/cli.ts dispatch-alerts-rich 12",
    "watchlist:list": "bun x tsx src/cli.ts watchlist:list default",
    "watchlist:moves": "bun x tsx src/cli.ts watchlist:moves default 25",
    "chart": "bun x tsx src/chart.ts",
    "dashboard": "bun x tsx src/coin-dashboard.ts",
    "price-volume": "bun x tsx src/price-volume.ts",
    "cluster-pie": "bun x tsx src/cluster-pie.ts",
    "cluster-flow": "bun x tsx src/cluster-flow.ts",
    "comment": "bun x tsx src/zora-comments.ts",
    "spark-value": "bun x tsx src/zora-comments.ts spark-value",
    "scout": "bun x tsx src/cli.ts scout",
    "scout-exec": "bun x tsx src/cli.ts scout-exec",
    "scout-live": "bun x tsx src/cli.ts scout-live",
    "positions": "bun x tsx src/cli.ts positions",
    "sell-monitor": "bun x tsx src/cli.ts sell-monitor"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@farcaster/hub-nodejs": "^0.15.10",
    "@irys/upload": "^0.0.15",
    "@irys/upload-ethereum": "^0.0.16",
    "@zoralabs/coins-sdk": "^0.5.1",
    "@zoralabs/protocol-deployments": "^0.7.2",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.3.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "viem": "^2.45.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.2.3"
  }
}
